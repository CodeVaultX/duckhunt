{
  "_comment_connections": "One entry per IRC server (preferred). Each entry gets its own bot connection and its own database file (duckhunt_<server>.json), so the same channel name on two networks never shares players. A single top-level \"connection\" object is still accepted for one-server setups.",
  "_comment_db_file": "Optional per entry: \"db_file\": \"myfile.json\" overrides that server's database file name. Without a 'server' value the legacy shared duckhunt.json is used.",
  "connections": [
    {
      "label": "Example network",
      "enabled": true,
      "server": "irc.example.net",
      "port": 6697,
      "nick": "Quackbot",
      "channels": [
        "#duckhunt"
      ],
      "ssl": true,
      "ssl_verify": true,
      "_comment_bind_address": "Optional: outbound source IP (e.g. an IPv6 address with matching rDNS). Must belong to this host. Leave empty to let the OS choose.",
      "bind_address": "",
      "password": "",
      "max_retries": 3,
      "retry_delay": 5,
      "timeout": 30,
      "_comment_send_throttle": "Minimum seconds between outgoing chat lines (PRIVMSG/NOTICE) to avoid server flood limits",
      "send_throttle": 0.3,
      "_comment_reconnect": "Automatic reconnection after an established connection drops. The delay starts at initial_delay and doubles up to max_delay between attempts.",
      "reconnect": {
        "enabled": true,
        "initial_delay": 5,
        "max_delay": 300
      },
      "_comment_ping": "Lag watchdog: if no server traffic arrives for ping_interval seconds, send a PING; if that goes unanswered for ping_timeout more seconds, the connection is treated as dead and reconnected.",
      "ping_interval": 120,
      "ping_timeout": 60,
      "auto_rejoin": {
        "enabled": true,
        "retry_interval": 20,
        "max_rejoin_attempts": 100
      },
      "_comment_sasl": "Optional per-server SASL. Omit to use the top-level sasl block below.",
      "sasl": {
        "enabled": false,
        "username": "",
        "password": ""
      },
      "_comment_nickserv": "Optional per-server services login. 'command' defaults to 'identify' (NickServ); QuakeNet's Q uses \"command\": \"auth\" plus \"username\". Skipped automatically when SASL already authenticated.",
      "nickserv": {
        "enabled": false,
        "service": "NickServ",
        "password": "",
        "identify_delay": 1.0
      }
    },
    {
      "label": "Second network (disabled example)",
      "enabled": false,
      "server": "irc.other.example",
      "port": 6667,
      "nick": "DuckHunt2",
      "channels": [
        "#duckhunt"
      ],
      "ssl": false,
      "ssl_verify": false,
      "password": ""
    }
  ],
  "sasl": {
    "enabled": false,
    "username": "",
    "password": ""
  },
  "admins": [
    "yourNickHere"
  ],
  "_comment_admins": "For stronger security than nick-only auth (spoofable if someone else takes that nick), use hostmask entries instead, e.g.: \"admins\": [{\"nick\": \"yourNickHere\", \"hostmask\": \"*!youruser@your.host\"}]",
  "commands": {
    "_comment_prefix": "The character(s) that trigger bot commands in-channel and in PM, e.g. '!' for !bang, '@' for @bang, '$' for $bang. Must be non-empty and contain no whitespace.",
    "prefix": "!"
  },
  "duck_spawning": {
    "spawn_min": 1200,
    "spawn_max": 3600,
    "timeout": 60,
    "rearm_on_duck_shot": true
  },
  "channel_overrides": {
    "_comment": "Per-channel settings. Keys must be lowercase. Only include settings you want to override.",
    "#slow-channel": {
      "duck_spawning": {
        "spawn_min": 3600,
        "spawn_max": 3600
      }
    }
  },
  "duck_types": {
    "normal": {
      "xp": 10,
      "timeout": 60,
      "drop_chance": 0.15
    },
    "golden": {
      "chance": 0.15,
      "min_hp": 3,
      "max_hp": 5,
      "xp": 15,
      "timeout": 60,
      "drop_chance": 0.5
    },
    "fast": {
      "chance": 0.25,
      "timeout": 20,
      "xp": 12,
      "drop_chance": 0.25
    },
    "ninja": {
      "chance": 0.10,
      "dodge_chance": 0.35,
      "xp": 15,
      "timeout": 60,
      "drop_chance": 0.3
    }
  },
  "item_drops": {
    "normal_duck_drops": [
      {"item_id": 1, "weight": 40},
      {"item_id": 2, "weight": 25},
      {"item_id": 4, "weight": 20}
    ],
    "fast_duck_drops": [
      {"item_id": 1, "weight": 30},
      {"item_id": 2, "weight": 25},
      {"item_id": 4, "weight": 20},
      {"item_id": 13, "weight": 15}
    ],
    "ninja_duck_drops": [
      {"item_id": 13, "weight": 30},
      {"item_id": 1, "weight": 30},
      {"item_id": 2, "weight": 20},
      {"item_id": 4, "weight": 20}
    ],
    "golden_duck_drops": [
      {"item_id": 5, "weight": 25},
      {"item_id": 14, "weight": 20},
      {"item_id": 7, "weight": 20},
      {"item_id": 2, "weight": 15},
      {"item_id": 13, "weight": 10},
      {"item_id": 1, "weight": 10}
    ]
  },
  "player_defaults": {
    "accuracy": 75,
    "magazines": 3,
    "bullets_per_magazine": 6,
    "jam_chance": 15,
    "xp": 0
  },
  "gameplay": {
    "befriend_success_rate": 75,
    "befriend_xp": 5,
    "accuracy_gain_on_hit": 1,
    "_comment_accuracy_loss_on_miss": "Accuracy lost per missed shot. Keeping this low (1) means a bad streak doesn't ruin a player's hit chance.",
    "accuracy_loss_on_miss": 1,
    "_comment_min_accuracy": "Hard lower bound for accuracy, so nobody ends up missing most of their shots. 50 = worst case is a coin flip.",
    "min_accuracy": 50,
    "max_accuracy": 100,
    "_comment_accuracy_soft_cap": "One-time per database file (stored in the DB metadata): accuracy above this is lowered once.",
    "accuracy_soft_cap": 90,
    "_comment_accuracy_floor": "One-time per database file (stored in the DB metadata): accuracy below this is raised once.",
    "accuracy_floor": 65,
    "min_befriend_success_rate": 5,
    "max_befriend_success_rate": 95,
    "wet_clothes_duration": 300
  },
  "features": {
    "shop_enabled": true,
    "inventory_enabled": true,
    "auto_rearm_enabled": true
  },
  "limits": {
    "max_inventory_items": 20,
    "max_per_item_type": 99,
    "max_temp_effects": 20
  },
  "debug": {
    "_comment_enabled": "Whether debug logging is enabled at all (true=debug mode, false=minimal logging)",
    "enabled": true,
    "_comment_log_level": "Overall logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)",
    "log_level": "DEBUG",
    "_comment_console_level": "Console output level - what shows in terminal (DEBUG, INFO, WARNING, ERROR)",
    "console_log_level": "INFO",
    "_comment_file_level": "File logging level - what gets written to log files (DEBUG, INFO, WARNING, ERROR)",
    "file_log_level": "DEBUG",
    "_comment_log_everything": "If true, logs ALL events. If false, logs only important events",
    "log_everything": true,
    "_comment_log_performance": "Whether to enable performance/metrics logging to performance.log",
    "log_performance": true,
    "_comment_unified_format": "If true, console and file logs use same format. If false, console has colors, file is plain",
    "unified_format": true
  }
}
